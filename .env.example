APP_NAME=AI Box API
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8100
API_PREFIX=/api
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://localhost:4200"]

# Bigship main API (staging: https://intlstagingapi.bigship.in, prod: https://appapi.bigship.direct)
BIGSHIP_API_BASE_URL=https://intlstagingapi.bigship.in

# Shared secret with the AI_python_backend gateway (AI_BOX_SERVICE_TOKEN). Empty = no check.
SERVICE_TOKEN=
# Attachment module (local extraction; no external AI calls)
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_TTL_SECONDS=86400
ATTACHMENT_OCR_LANGUAGE=eng
ATTACHMENT_VISION_BASE_URL=https://api.deepseek.com
ATTACHMENT_VISION_MODEL=deepseek-flash
ATTACHMENT_VISION_API_KEY=

# Audit log module (AI calling): Voice AI admin API. The admin key stays on this server.
VOICEAI_BASE_URL=https://voiceai.bigship.direct
VOICEAI_ADMIN_KEY=
# Callers send this in X-Audit-Key to read /api/audit_log/*. Empty = audit log API disabled.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_LOG_API_KEY=

# Meta integration (/api/meta/*). See META_INTEGRATION.md. Empty values keep the module disabled
# (its endpoints answer META_PLATFORM_NOT_CONFIGURED); every other module keeps working.
# Same PostgreSQL database as AI_python_backend (tables are prefixed meta_). META_DATABASE_URL overrides.
DATABASE_URL=
META_APP_ID=
META_APP_SECRET=
# Pin a version you verified is supported (v27.0 is current as of Nov 2026).
META_GRAPH_API_VERSION=
META_WHATSAPP_CONFIG_ID=
META_FACEBOOK_CONFIG_ID=
META_INSTAGRAM_CONFIG_ID=   # Instagram via Facebook Login for Business (preferred); leave the two below empty
META_INSTAGRAM_APP_ID=
META_INSTAGRAM_APP_SECRET=
META_OAUTH_REDIRECT_URI=
META_FRONTEND_RETURN_URL=
META_PUBLIC_API_BASE_URL=
META_WEBHOOK_VERIFY_TOKEN=
META_WEBHOOK_CALLBACK_URL=
# {"1":"<base64 32-byte key>"}; generate: python -c "import base64,os;print(base64.b64encode(os.urandom(32)).decode())"
META_TOKEN_ENCRYPTION_KEYS=
META_TOKEN_ENCRYPTION_ACTIVE_KEY=
META_SYNC_ENABLED=true
META_SYNC_INTERVAL_MINUTES=30
META_HTTP_TIMEOUT_SECONDS=20
META_WORKER_ENABLED=true
META_ADMIN_API_KEY=
# Seller identity for /api/meta: "bigship" (default) asks BigShip GET /api/get-user-profile whose login token
# (X-Shipment-Authorization) the request carries, using BIGSHIP_API_BASE_URL above. "header" trusts X-User-Id
# and is refused when ENV=production.
META_SELLER_IDENTITY=bigship
META_SELLER_IDENTITY_CACHE_SECONDS=300

# Email integration (/api/email/*): sellers connect their own Gmail / Outlook mailbox and AI Box puts the report
# email (AI-written body + PDF) there as a draft, opened in a new tab. See EMAIL_INTEGRATION.md.
# Same PostgreSQL database as AI_python_backend (tables are prefixed email_). EMAIL_DATABASE_URL overrides.
# Generate a key: python -c "from app.core.crypto import new_key; print(new_key())"
EMAIL_TOKEN_ENCRYPTION_KEYS=
EMAIL_TOKEN_ENCRYPTION_ACTIVE_KEY=1
# Google Cloud console > Google Auth Platform > Clients (Web). Scopes: openid email gmail.compose
EMAIL_GOOGLE_CLIENT_ID=
EMAIL_GOOGLE_CLIENT_SECRET=
# Microsoft Entra > App registrations. Delegated permissions: openid email offline_access User.Read Mail.ReadWrite
EMAIL_MICROSOFT_CLIENT_ID=
EMAIL_MICROSOFT_CLIENT_SECRET=
EMAIL_MICROSOFT_TENANT=common
# Registered with both providers; reached through the AI_python_backend gateway.
EMAIL_OAUTH_REDIRECT_URI=http://localhost:8200/api/email/oauth/callback
# Shared with AI_python_backend (its AI_BOX_EMAIL_INTERNAL_KEY): only the backend may create drafts.
EMAIL_INTERNAL_KEY=
EMAIL_DRAFTS_PER_HOUR=60
EMAIL_SELLER_IDENTITY=bigship

# AI assistant (POST /api/assistant/ask): any OpenAI-compatible chat API, DeepSeek by default.
AI_ASSISTANT_AI_BASE_URL=https://api.deepseek.com
AI_ASSISTANT_AI_MODEL=deepseek-chat
AI_ASSISTANT_AI_API_KEY=
AI_ASSISTANT_TIMEOUT_SECONDS=55
AI_ASSISTANT_MAX_OUTPUT_TOKENS=2000
# Chat history + token usage (assistant_* tables) in the AI_python_backend database; falls back to DATABASE_URL.
# Empty: chat/history/limits are off and only /api/assistant/ask works.
AI_ASSISTANT_DATABASE_URL=
# Tokens per user per IST day / week (from Monday) / month; 0 = no limit. assistant_limits rows override per user.
AI_ASSISTANT_DAILY_TOKEN_LIMIT=50000
AI_ASSISTANT_WEEKLY_TOKEN_LIMIT=250000
AI_ASSISTANT_MONTHLY_TOKEN_LIMIT=800000
# Earlier messages sent back to the AI with each new one.
AI_ASSISTANT_HISTORY_MESSAGES=20
AI_ASSISTANT_HISTORY_CHARS=30000
