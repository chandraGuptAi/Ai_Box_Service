APP_NAME=AI Box API
ENV=development
DEBUG=true
HOST=0.0.0.0
PORT=8100
API_PREFIX=/api
LOG_LEVEL=INFO
CORS_ALLOWED_ORIGINS=["http://localhost:4200"]

# Bigship main API (staging: https://intlstagingapi.bigship.in, prod: https://appapi.bigship.direct)
BIGSHIP_API_BASE_URL=https://intlstagingapi.bigship.in

# Shared secret with the AI_python_backend gateway (AI_BOX_SERVICE_TOKEN). Empty = no check.
SERVICE_TOKEN=
# Attachment module (local extraction; no external AI calls)
ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_TTL_SECONDS=86400
ATTACHMENT_OCR_LANGUAGE=eng
ATTACHMENT_VISION_BASE_URL=https://api.deepseek.com
ATTACHMENT_VISION_MODEL=deepseek-flash
ATTACHMENT_VISION_API_KEY=

# Audit log module (AI calling): Voice AI admin API. The admin key stays on this server.
VOICEAI_BASE_URL=https://voiceai.bigship.direct
VOICEAI_ADMIN_KEY=
# Callers send this in X-Audit-Key to read /api/audit_log/*. Empty = audit log API disabled.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
AUDIT_LOG_API_KEY=
