APP_NAME=AI Box API
ENV=production
DEBUG=false
API_PREFIX=/api
LOG_LEVEL=INFO

# Required: generate with: python -c "import secrets; print(secrets.token_hex(32))"
# Set the same value as AI_BOX_SERVICE_TOKEN in AI_python_backend.
SERVICE_TOKEN=

# Choose the upstream appropriate for your environment.
BIGSHIP_API_BASE_URL=https://intlstagingapi.bigship.in

# Host publishing; use a private interface IP for a gateway on another server.
BIND_HOST=127.0.0.1
PUBLISHED_PORT=8100

ATTACHMENT_MAX_BYTES=20971520
ATTACHMENT_TTL_SECONDS=86400
ATTACHMENT_OCR_LANGUAGE=eng
ATTACHMENT_VISION_BASE_URL=https://api.deepseek.com
ATTACHMENT_VISION_MODEL=deepseek-flash
ATTACHMENT_VISION_API_KEY=

# Downloads on first semantic lookup; cached in the persistent data volume.
REPORT_MEMORY_SEMANTIC=true

# Audit log module (AI calling)
VOICEAI_BASE_URL=
VOICEAI_ADMIN_KEY=
AUDIT_LOG_API_KEY=
